PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# OSRM (internal only — never expose 5000 publicly)
OSRM_URL=http://localhost:5000
OSRM_TIMEOUT_MS=15000

# OSRM map data — where to download/store the graph (host bind mount)
# Brazil: ~2 GB PBF + ~16 GB graph (~18 GB total). Point OSRM_DATA_DIR to a disk with >= 20 GB free.
# OSRM_EXTRACT: base name; expects <EXTRACT>.osm.pbf and produces <EXTRACT>.osrm
# Example for Rio Grande do Sul (openstreetmap.fr):
#   OSRM_EXTRACT=rio-grande-do-sul-latest
#   OSRM_PBF_URL=https://download.openstreetmap.fr/extracts/south-america/brazil/south/rio-grande-do-sul-latest.osm.pbf
OSRM_DATA_DIR=./.osrm-data
OSRM_EXTRACT=brazil-latest
OSRM_PBF_URL=https://download.geofabrik.de/south-america/brazil-latest.osm.pbf

# Injected into every internal OSRM call
PARAM_OVERVIEW=full
PARAM_GEOMETRIES=geojson
DEFAULT_PROFILE=motorcycle

# Firebase Auth
# Issuer must be https://securetoken.google.com/<FIREBASE_PROJECT_ID>
AUTH_ISSUER_URL=https://securetoken.google.com/your-firebase-project-id
FIREBASE_PROJECT_ID=your-firebase-project-id
# Web API Key (public client key) — used by /api/v1/auth/signup and /login
# Console Firebase → Configurações do projeto → Web API Key
FIREBASE_API_KEY=your-web-api-key
# Set to true only for local development / automated tests
AUTH_DISABLED=false

# Rate limit (per authenticated uid, fallback IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
